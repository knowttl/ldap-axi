{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ldap-axi profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["url"],
  "properties": {
    "url": { "type": "string", "pattern": "^ldaps?://", "description": "LDAP URL without userinfo; use the server FQDN for ambient authentication" },
    "auth": { "enum": ["auto", "gssapi", "simple"], "default": "auto" },
    "bindDn": { "type": "string", "minLength": 1, "description": "Simple-bind identity, required for simple authentication" },
    "bindPassword": {
      "x-secret": true,
      "description": "Simple-bind password reference; defaults to env LDAP_AXI_BIND_PASSWORD. No stored secrets.",
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["env"], "properties": { "env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } } },
        { "type": "object", "additionalProperties": false, "required": ["file"], "properties": { "file": { "type": "string", "pattern": "^(?:/|[A-Za-z]:[\\\\/])", "description": "Absolute local path to a private UTF-8 password file; UNC/device paths are forbidden on Windows" } } }
      ]
    },
    "base": { "type": "string" },
    "pageSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "caFile": { "type": "string", "minLength": 1 },
    "startTls": { "type": "boolean", "default": false },
    "tlsMaxVersion": { "const": "1.2" },
    "flavor": { "enum": ["ad", "adlds", "ldapv3"] },
    "gssapiService": { "type": "string", "minLength": 1 },
    "gssapiProtection": { "enum": ["none", "confidentiality"] }
  }
}
